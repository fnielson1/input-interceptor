; interceptor-driver.inf
;
; Registers interceptor-driver.sys as a LowerFilter of BOTH the keyboard and
; mouse device setup classes, so it attaches to every keyboard and mouse
; PnP creates a stack for (PS/2, USB, Bluetooth, HID, ...), not just one
; specific hardware ID -- see driver/connect.c for why LowerFilters, not
; UpperFilters, is required.
;
; NOTE: this INF has not been validated with InfVerif/Inf2Cat or a real
; install, since this repo was authored on a machine without the WDK (see
; README). Before relying on it, run InfVerif.exe (ships with the WDK) and
; do a real test-signed install; the plan this was built from flags the
; [ClassInstall32] dual-class-key AddReg technique below, and the exact
; driver Start value, as the two details most worth double-checking against
; a real WDK toolchain.
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = Keyboard
ClassGuid   = {4D36E96B-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 01/01/2026,1.0.0.0
CatalogFile = interceptor-driver.cat
PnpLockdown = 1

; No [Manufacturer]/[Models] hardware-ID matches: this is a pure class
; filter, installed via [ClassInstall32] below rather than by binding to
; any specific device. pnputil /add-driver .../install processes
; [DefaultInstall]/[DefaultInstall.Services] as the primitive install path
; for a package with no device match -- InfVerif rejects an INF that has
; both a [Manufacturer] section AND a [DefaultInstall] section, so the
; device-match section is omitted entirely rather than left empty.

[ClassInstall32]
Addreg = Interceptor.ClassFilterReg

[Interceptor.ClassFilterReg]
; HKR here resolves to the keyboard class key declared by ClassGuid= above.
HKR,,"LowerFilters",0x00010008,"InterceptorDriver"
; Explicit absolute path for the mouse class key, since one [Version]
; section can only declare a single "home" ClassGuid.
HKLM,"SYSTEM\CurrentControlSet\Control\Class\{4D36E96F-E325-11CE-BFC1-08002BE10318}","LowerFilters",0x00010008,"InterceptorDriver"

[DestinationDirs]
DefaultDestDir = 12 ; %SystemRoot%\System32\drivers

[SourceDisksNames]
1 = %DiskDescription%

[SourceDisksFiles]
interceptor-driver.sys = 1

[DefaultInstall.NTamd64]
CopyFiles = Interceptor.CopyDriverFiles

[Interceptor.CopyDriverFiles]
interceptor-driver.sys

[DefaultInstall.NTamd64.Services]
AddService = InterceptorDriver,,Interceptor.ServiceInstall

[Interceptor.ServiceInstall]
DisplayName    = %ServiceName%
Description    = %ServiceDesc%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
; SERVICE_SYSTEM_START: a LowerFilter under kbdclass/mouclass must start no
; later than they do. Verify against the real kbdclass/mouclass Start value
; on the target machine
; (HKLM\SYSTEM\CurrentControlSet\Services\kbdclass\Start) before relying on
; this -- flagged above as unverified without a WDK toolchain to check
; against.
StartType      = 1
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\interceptor-driver.sys

[Strings]
ProviderName  = "input-interceptor"
ServiceName   = "InterceptorDriver"
ServiceDesc   = "Interceptor keyboard/mouse filter driver"
DiskDescription = "Interceptor driver installation disk"
