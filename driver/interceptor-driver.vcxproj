<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{7B1B7E1E-6E2E-4E7C-9B7B-6D8B6C9F2A11}</ProjectGuid>
    <RootNamespace>interceptordriver</RootNamespace>
    <Platform>x64</Platform>
    <MinimumVisualStudioVersion>15.0</MinimumVisualStudioVersion>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- Some WDK releases only ship InfVerif.dll for the x64/arm64 host
         tool directories, not x86; forcing x64 host tools avoids that
         missing-DLL failure during the InfVerif build step. -->
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="ExtensionSettings" />

  <PropertyGroup Label="UserMacros" />

  <PropertyGroup>
    <TargetName>interceptor-driver</TargetName>
    <OutDir>build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>build\$(Platform)\$(Configuration)\obj\</IntDir>
  </PropertyGroup>

  <!--
    Test-signing defaults for local development builds only. For a real
    release, replace with attestation or EV signing per the README's
    Requirements section; do not check a real signing certificate into
    source control.
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PreprocessorDefinitions>%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Driversign>
      <SignMode>TestSign</SignMode>
      <FileDigestAlgorithm>SHA256</FileDigestAlgorithm>
    </Driversign>
    <Inf2Cat>
      <OSList>10_X64</OSList>
    </Inf2Cat>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="driver.c" />
    <ClCompile Include="pnp.c" />
    <ClCompile Include="connect.c" />
    <ClCompile Include="dispatch.c" />
    <ClCompile Include="queue.c" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="driver.h" />
    <ClInclude Include="protocol.h" />
  </ItemGroup>

  <ItemGroup>
    <ResourceCompile Include="interceptor-driver.rc" />
  </ItemGroup>

  <ItemGroup>
    <Inf Include="interceptor-driver.inf" />
  </ItemGroup>

  <!--
    GetPackageFiles only auto-adds the stamped .inf's CopyOutput to
    FilesToPackage, not the driver binary itself, so Inf2Cat otherwise
    can't find interceptor-driver.sys next to the .inf it's cataloging.
  -->
  <ItemGroup>
    <FilesToPackage Include="$(OutDir)$(TargetName)$(TargetExt)" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
